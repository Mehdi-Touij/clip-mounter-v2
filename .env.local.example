# === AI Planner (Ollama Cloud, OpenAI-compatible) ===
PLANNER_BASE_URL=https://ollama.com/v1
PLANNER_MODEL=glm-5.2
# API key — either name works.
OLLAMA_API_KEY=
# PLANNER_API_KEY=

# === Deployment (docker-compose) ===
# Set a domain for automatic HTTPS, or leave the default ":80" for IP access.
# SITE_ADDRESS=clips.yourdomain.com

# === Data + tuning (optional; sensible defaults) ===
# DATA_DIR=/data                 # SQLite + videos + outputs + tmp live here (mounted volume)
# MAX_ATTEMPTS=4                 # per-video retry budget before giving up
# YT_PLAYER_CLIENTS=default,web_safari,tv,android,ios
# YT_COOKIES=youtube-cookies.txt # path to a real Netscape cookie jar (improves download success)
